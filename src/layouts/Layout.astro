---
import "src/styles/global.css";

import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";

interface Props {
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.url.origin).toString();
const resolvedImageWithDomain = new URL(
  "/og-image.jpeg",
  Astro.url.origin,
).toString();

const { title } = Astro.props;
const pageTitle = title || "Javier Picón";

const currentLocale = Astro.currentLocale || "es";
const isSpanish = currentLocale === "es";
const metaDescription = isSpanish
  ? "Portfolio de Javier Picón, desarrollador backend especializado en banca con Java y GEN IA."
  : "Javier Picón's portfolio, a backend developer focused on banking solutions with Java and GEN IA.";
const ogLocale = isSpanish ? "es_ES" : "en_US";
const alternateLocale = isSpanish ? "en_US" : "es_ES";
const alternatePath = isSpanish
  ? `/en${Astro.url.pathname}`
  : Astro.url.pathname.replace(/^\/en/, "") || "/";
const alternateURL = new URL(alternatePath, Astro.url.origin).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: pageTitle,
  description: metaDescription,
  url: canonicalURL,
  image: resolvedImageWithDomain,
  inLanguage: currentLocale,
  mainEntity: {
    "@type": "Person",
    name: "Javier Picón",
    url: Astro.url.origin,
    sameAs: [
      "https://github.com/mcpikon",
      "https://www.linkedin.com/in/javier-picon/",
      "https://www.instagram.com/mcpikon/",
      "https://x.com/mcpikon",
    ],
  },
};
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#141414" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="google-site-verification"
      content="Pw96Vux3r5C9-8rbsJZRP8Vu17fbr9bNvtOPfoSb5Gg"
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={currentLocale} href={canonicalURL} />
    <link
      rel="alternate"
      hreflang={isSpanish ? "en" : "es"}
      href={alternateURL}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL("/", Astro.url.origin).toString()}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content="Javier Picón" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={resolvedImageWithDomain} />
    <meta property="og:image:secure_url" content={resolvedImageWithDomain} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portfolio de Javier Picón" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mcpikon" />
    <meta name="twitter:creator" content="@mcpikon" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={resolvedImageWithDomain} />
    <meta name="twitter:image:alt" content="Portfolio de Javier Picón" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <script is:inline>
      (() => {
        const getSystemTheme = () =>
          window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";

        const root = document.documentElement;
        const motionQuery = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );

        const resolveTheme = () => {
          const storedTheme = localStorage.getItem("theme");
          return storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : getSystemTheme();
        };

        const setThemeOnRoot = (theme) => {
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          return theme;
        };

        const syncTheme = () => {
          const theme = setThemeOnRoot(resolveTheme());
          document.dispatchEvent(
            new CustomEvent("theme:sync", { detail: { theme } }),
          );
          return theme;
        };

        const runThemeFallbackTransition = (updateTheme) => {
          root.classList.remove("theme-transition-fallback");
          window.clearTimeout(window.__themeTransitionTimeout);
          requestAnimationFrame(() => {
            root.classList.add("theme-transition-fallback");
            updateTheme();
            window.__themeTransitionTimeout = window.setTimeout(() => {
              root.classList.remove("theme-transition-fallback");
            }, 260);
          });
        };

        const applyPreferredTheme = (nextTheme, options = {}) => {
          const { persist = true, animate = true } = options;
          const currentTheme = root.dataset.theme ?? resolveTheme();

          if (persist) {
            localStorage.setItem("theme", nextTheme);
          }

          if (currentTheme === nextTheme) {
            return setThemeOnRoot(nextTheme);
          }

          const updateTheme = () => setThemeOnRoot(nextTheme);
          const canUseViewTransition =
            animate &&
            !motionQuery.matches &&
            document.startViewTransition instanceof Function;

          if (canUseViewTransition) {
            document.startViewTransition(updateTheme);
            return nextTheme;
          }

          if (animate && !motionQuery.matches) {
            runThemeFallbackTransition(updateTheme);
            return nextTheme;
          }

          return updateTheme();
        };

        const setupSystemListener = () => {
          if (root.dataset.themeListenerReady === "true") return;
          root.dataset.themeListenerReady = "true";

          const media = window.matchMedia("(prefers-color-scheme: light)");
          media.addEventListener("change", (event) => {
            const storedTheme = localStorage.getItem("theme");
            if (storedTheme === "light" || storedTheme === "dark") return;
            const theme = setThemeOnRoot(event.matches ? "light" : "dark");
            document.dispatchEvent(
              new CustomEvent("theme:sync", { detail: { theme } }),
            );
          });
        };

        window.__applyPreferredTheme = applyPreferredTheme;
        syncTheme();
        setupSystemListener();
        document.addEventListener("astro:after-swap", () => {
          syncTheme();
        });
      })();
    </script>
    <ClientRouter />
    <Font cssVariable="--font-ibm-plex-sans" preload />
  </head>
  <body class="antialiased header-padding-transition">
    <slot />

    <style is:global>
      /* ── Fade-up on scroll ── */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition:
          opacity 0.6s ease,
          transform 0.6s ease;
      }
      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* ── Zoom in ── */
      .reveal-zoom {
        opacity: 0;
        transform: scale(0.92);
        transition:
          opacity 0.6s ease,
          transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      .reveal-zoom.visible {
        opacity: 1;
        transform: scale(1);
      }

      /* ── Delays encadenables ── */
      .reveal-delay-1 {
        transition-delay: 100ms;
      }
      .reveal-delay-2 {
        transition-delay: 200ms;
      }
      .reveal-delay-3 {
        transition-delay: 300ms;
      }
      .reveal-delay-4 {
        transition-delay: 400ms;
      }
      .reveal-delay-5 {
        transition-delay: 500ms;
      }

      img {
        content-visibility: auto;
      }
      html {
        scroll-behavior: smooth;
        scrollbar-gutter: stable;
        background-color: var(--color-bg);
        min-height: 100%;
        transition: none;
      }
      body {
        padding-top: 3.5rem;
      }
      body {
        font-family: var(--font-ibm-plex-sans), system-ui, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text);
        background-size: 22px 22px;
        overflow-x: hidden;
        min-height: 100%;
        transition: none;
      }

      html.theme-transition-fallback,
      html.theme-transition-fallback body,
      html.theme-transition-fallback :where(a, button, svg, path) {
        transition:
          background-color 220ms ease,
          color 220ms ease,
          border-color 220ms ease,
          fill 220ms ease,
          stroke 220ms ease,
          box-shadow 220ms ease;
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 320ms;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      }

      @media (prefers-reduced-motion: reduce) {
        html.theme-transition-fallback,
        html.theme-transition-fallback body,
        html.theme-transition-fallback :where(a, button, svg, path),
        ::view-transition-old(root),
        ::view-transition-new(root) {
          transition-duration: 0ms;
          animation-duration: 0ms;
        }
      }

      body .cursor {
        position: fixed;
        z-index: 100;
        height: 15px;
        width: 15px;
        border-radius: 36px;
        background-color: var(--color-cursor);
        box-shadow:
          0 0 24px 0 var(--color-shadow),
          0 1px 0 0 #0000;
        pointer-events: none;
        transition: all 200ms ease-out;
        left: -18px;
        top: -18px;
        box-sizing: border-box;
      }
      ::-webkit-scrollbar {
        width: 10px;
      }

      ::-webkit-scrollbar-track {
        background-color: var(--color-scrollbar-track);
        -webkit-border-radius: 10px;
        border-radius: 10px;
      }

      ::-webkit-scrollbar-thumb {
        -webkit-border-radius: 10px;
        border-radius: 10px;
        background: var(--color-scrollbar-thumb);
      }
    </style>
    <script is:inline>
      function setupAnimations() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("visible");
                // Una vez visible, dejar de observar (como AOS por defecto)
                observer.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12 },
        );

        document
          .querySelectorAll(".reveal, .reveal-zoom")
          .forEach((el) => observer.observe(el));
      }

      setupAnimations();
      document.addEventListener("astro:after-swap", setupAnimations);
    </script>
  </body>
</html>
